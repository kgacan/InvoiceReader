@page
@model PasswordModel
@{
    ViewData["Title"] = "Promjena lozinke";
}
<div class="page-head">
    <h1>Promjena lozinke</h1>
</div>

@if (Model.Message is not null)
{
    <p class="notice">@Model.Message</p>
}

<section class="card narrow">
    <form method="post" class="stack">
        <label for="current">Trenutna lozinka</label>
        <input id="current" name="CurrentPassword" type="password" autocomplete="current-password" required />
        <label for="new">Nova lozinka (najmanje @InvoiceReader.Web.Services.UserAccounts.MinPasswordLength znakova)</label>
        <input id="new" name="NewPassword" type="password" autocomplete="new-password" minlength="@InvoiceReader.Web.Services.UserAccounts.MinPasswordLength" required />
        <label for="confirm">Ponovite novu lozinku</label>
        <input id="confirm" name="ConfirmPassword" type="password" autocomplete="new-password" required />
        @if (Model.Error is not null)
        {
            <p class="error">@Model.Error</p>
        }
        <button type="submit" class="primary">Promijeni lozinku</button>
    </form>
</section>
